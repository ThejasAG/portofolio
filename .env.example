# Hiring form (server-side only — never exposed to the browser).
# Without these the /api/hire endpoint returns 503 and the form tells the
# visitor to email directly, rather than pretending the message was sent.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_EMAIL=thejasag5518@gmail.com

# Verified sender. Resend's shared onboarding@resend.dev works for testing;
# use an address on your own verified domain in production.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
